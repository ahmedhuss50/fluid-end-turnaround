# ---- Database (Supabase Postgres) ----
# Runtime connection: use Supabase's POOLED connection (Transaction mode, port 6543).
# Note the ?pgbouncer=true flag — required for Prisma with pgbouncer.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations connection: use the DIRECT connection (Session mode, port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- E-signature provider: "mock" (default, works offline) or "boldsign" ----
ESIGN_PROVIDER="mock"
BOLDSIGN_API_KEY=""
BOLDSIGN_API_BASE="https://api.boldsign.com"

# ---- Certificate storage: "local" (dev) or "supabase" (production/Vercel) ----
# Vercel's filesystem is read-only, so use "supabase" in production.
STORAGE_DRIVER="local"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""          # server-side only — never expose to the browser
SUPABASE_CERT_BUCKET="certificates"

# ---- App ----
# Public base URL of the deployment (used to build signing links).
APP_BASE_URL="http://localhost:3000"
