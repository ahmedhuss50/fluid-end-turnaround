// Fluid End Turnaround System — Phase 1 data model
// Postgres (Supabase). DATABASE_URL is the pooled connection (pgbouncer, :6543)
// used at runtime; DIRECT_URL is the direct connection (:5432) used for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A login account. Role determines the default portal (PSI staff vs operator).
/// No email verification — accounts are active on creation (seeded for now).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("client") // psi | client
  company      String? // operator company for client users, e.g. "Pro Petro"
  mustChangePassword Boolean @default(true) // force a password change on first login
  createdAt    DateTime @default(now())
}

/// A physical fluid end (the unit). Permanent record, keyed by serial number.
model FluidEnd {
  id           String          @id @default(cuid())
  serialNumber String          @unique
  manufacturer String
  customer     String // owning operator, e.g. "Pro Petro"
  model        String? // optional configuration / spec
  tagId        String? // reserved for Phase 2 (RFID / barcode)
  createdAt    DateTime        @default(now())
  jobs         TurnaroundJob[]
}

/// One turnaround event for a fluid end.
model TurnaroundJob {
  id            String        @id @default(cuid())
  jobNumber     String        @unique // human-friendly, e.g. "TA-2026-0007"
  fluidEnd      FluidEnd      @relation(fields: [fluidEndId], references: [id])
  fluidEndId    String
  status        String        @default("DRAFT") // DRAFT | AWAITING_PSI | AWAITING_OPERATOR | COMPLETED
  stage         String        @default("INSPECTION") // pipeline stage: INSPECTION | WORK | TEST | SIGNOFF
  technician    String // PSI tech who performed the work
  intakeDate    DateTime      @default(now())
  completedDate DateTime?
  replacedParts String        @default("[]") // JSON array of part keys
  notes         String?
  inspectionNotes String?     // findings from the inspection stage
  outcome         String?     // READY_PICKUP | READY_DELIVERY | SCRAP
  nameplatePhotoKey String?   // storage key for the captured nameplate photo
  certificateUrl String?      // path to signed PDF once completed
  // Receiving / chain of custody (captured when PSI takes possession)
  deliveryMethod   String? // PICKUP (PSI collects) | DELIVERY (client drops off)
  receivedByPsi    String? // PSI person who took possession (signature)
  releasedByClient String? // client person who released it (signature)
  receivedAt       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  pressureTest  PressureTest?
  signatures    Signature[]
  notifications Notification[]
  invoice       Invoice?
  isBatch       Boolean       @default(false) // combined work order covering multiple fluid ends
  extraUnits    JobUnit[] // units 2..N of a batch (unit 1 is fluidEnd above)
}

/// An additional fluid end on a batch (combined) work order. The job's primary
/// unit is its fluidEnd; these are the rest of the units in the same batch.
model JobUnit {
  id           String        @id @default(cuid())
  job          TurnaroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        String
  serialNumber String
  manufacturer String
  model        String?
  problem      String?
  order        Int           @default(0)

  @@index([jobId])
}

/// A client batch submission: multiple fluid ends requested for repair together
/// under one authorization signature. PSI turns it into one combined work order.
model RequestBatch {
  id                String             @id @default(cuid())
  batchNumber       String             @unique // e.g. RB-2026-0001
  company           String
  contactName       String
  contactEmail      String?
  contactPhone      String?
  clientSignerName  String
  clientSignerTitle String?
  clientSignedAt    DateTime           @default(now())
  deliveryMethod    String?
  notes             String?
  status            String             @default("SUBMITTED") // SUBMITTED | CONVERTED
  jobId             String? // linked combined work order once converted
  createdAt         DateTime           @default(now())
  items             RequestBatchItem[]
}

model RequestBatchItem {
  id           String       @id @default(cuid())
  batch        RequestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId      String
  serialNumber String
  manufacturer String
  model        String?
  problem      String?
  order        Int          @default(0)

  @@index([batchId])
}

/// A single invoice for a completed work order. PSI enters the line items and
/// amounts; the PDF is issued automatically when the work order completes.
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // e.g. INV-2026-0001
  job           TurnaroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String        @unique
  status        String        @default("DRAFT") // DRAFT | ISSUED
  currency      String        @default("USD")
  taxRatePct    Float         @default(0) // e.g. 8.25 (percent)
  notes         String?
  terms         String?       @default("Net 30")
  poNumber      String? // client purchase-order reference
  pdfUrl        String? // path to the issued PDF
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
}

/// One line on an invoice. Prices are stored in integer cents to avoid float drift.
model InvoiceItem {
  id             String  @id @default(cuid())
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  description    String
  quantity       Float   @default(1)
  unitPriceCents Int     @default(0)
  order          Int     @default(0)

  @@index([invoiceId])
}

/// A portal notification + the (mock) email that was dispatched for it.
/// Recipient is a party ("PRO_PETRO" = the operator/client portal, "PSI").
model Notification {
  id         String        @id @default(cuid())
  job        TurnaroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  recipient  String        // party who should see it: PRO_PETRO | PSI
  type       String        // SIGN_REQUEST | COMPLETED
  subject    String        // email + inbox subject line
  preview    String        // short summary shown in the inbox list
  emailHtml  String        // rendered HTML body of the exact email sent
  toName     String?       // recipient display name
  toEmail    String?       // recipient email address (may be blank in demo)
  signToken  String?       // token deep-linking to the operator's signing page
  read       Boolean       @default(false)
  emailedAt  DateTime?     // when the (mock) email was dispatched
  createdAt  DateTime      @default(now())

  @@index([recipient, read])
  @@index([jobId])
}

/// Pressure-test result attached to a job.
model PressureTest {
  id              String        @id @default(cuid())
  job             TurnaroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId           String        @unique
  testPressurePsi Int
  holdTimeMinutes Int
  result          String // PASS | FAIL
  gauge           String? // instrument / transducer used
  testedBy        String
  testedAt        DateTime      @default(now())
}

/// A client-submitted request to repair a fluid end. Carries the client's
/// authorization signature. PSI converts it into a TurnaroundJob (work order).
model RepairRequest {
  id                String   @id @default(cuid())
  requestNumber     String   @unique // e.g. RR-2026-0001
  company           String // owning operator / client company
  contactName       String
  contactEmail      String?
  contactPhone      String?
  serialNumber      String
  manufacturer      String
  model             String?
  problem           String // description of the issue / reason for repair
  requestedService  String?
  clientSignerName  String // authorization signature (typed)
  clientSignerTitle String?
  clientSignedAt    DateTime @default(now())
  deliveryMethod    String? // PICKUP (PSI collects) | DELIVERY (client drops off)
  nameplatePhotoKey String? // storage key for the captured nameplate photo
  status            String   @default("SUBMITTED") // SUBMITTED | CONVERTED
  jobId             String? // linked work order once converted
  createdAt         DateTime @default(now())
}

/// A chain-of-custody handoff of a fluid end: the client signs to RELEASE it,
/// then PSI signs to RECEIVE it. Independent of the work order.
model Handoff {
  id             String    @id @default(cuid())
  handoffNumber  String    @unique // e.g. HO-2026-0001
  serialNumber   String
  manufacturer   String?
  customer       String
  deliveryMethod String? // PICKUP | DELIVERY
  conditionNotes String?
  // Release (client)
  releasedByName  String
  releasedByTitle String?
  releasedAt      DateTime @default(now())
  // Receive (PSI)
  receivedByName String?
  receivedAt     DateTime?
  status         String    @default("RELEASED") // RELEASED | RECEIVED
  requestId      String? // optional link to the repair request this unit came from
  createdAt      DateTime  @default(now())
}

/// One signature request/record. A completed job has two: PSI then Pro Petro.
model Signature {
  id          String        @id @default(cuid())
  job         TurnaroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  party       String // PSI | PRO_PETRO
  order       Int // 1 = PSI, 2 = Pro Petro
  signerName  String
  signerRole  String?
  signerEmail String?
  status      String        @default("PENDING") // PENDING | SIGNED
  token       String        @unique // opaque link token for signing
  signedAt    DateTime?
  auditIp     String?
  auditMeta   String? // JSON: user agent, provider reference, etc.
  providerRef String? // external e-sign provider envelope/document id
  createdAt   DateTime      @default(now())

  @@index([jobId])
}
